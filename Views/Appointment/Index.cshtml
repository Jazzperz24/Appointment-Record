@model IEnumerable<Appointment_Record_Management_System.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-4">Appointment Records</h1>
        <p>Manage your appointments.</p>
    </div>
    <a class="btn btn-primary btn-lg" href="@Url.Action("Create", "Appointment")" role="button">
        Create an Appointment
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No appointments found. Please create a new appointment.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client Name</th>
                <th>Service</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ClientName</td>
                    <td>@item.Service</td>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.Time.ToString(@"hh\:mm")</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}